APP_NAME="Panel del servidor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel_status
DB_USERNAME=panel_status
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PANEL_ADMIN_NAME=Administrador
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=
PANEL_SERVER_NAME="Servidor principal"
PANEL_SERVER_HOSTNAME=servidor
PANEL_SERVICES=nginx,php8.4-fpm,mariadb,tailscaled,ngrok
PANEL_MOUNTS=/
PANEL_PROC_PATH=/proc
PANEL_SYS_PATH=/sys
PANEL_SYSTEMCTL_ENABLED=true
PANEL_SYSTEMCTL_BINARY=/usr/bin/systemctl
PANEL_STALE_AFTER_SECONDS=180
PANEL_HTTP_DEGRADED_MS=1500
PANEL_LOCK_TIMEOUT_SECONDS=60
PANEL_ALLOWED_CHECK_HOSTS=127.0.0.1,localhost
NEXTCLOUD_STATUS_URL=http://127.0.0.1/status.php
FCM_CREDENTIALS_PATH=/etc/panel/fcm-service-account.json
