[Unit]
Description=Túnel ngrok solo para las aplicaciones de prueba
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=ngrok
Group=www-data
EnvironmentFile=/etc/panel/ngrok.env
ExecStart=/usr/bin/ngrok http http://127.0.0.1:8080
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
